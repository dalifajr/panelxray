#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

# ==========================================
# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
# ==========================================
clear
               hariini=`date +%d-%m-%Y`
               echo "Thank you for removing the EXPIRED USERS"
               echo "--------------------------------------"
               cat /etc/shadow | cut -d: -f1,8 | sed /:$/d > /tmp/expirelist.txt
               totalaccounts=`cat /tmp/expirelist.txt | wc -l`
               EXPIRE_GRACE_DAYS="${EXPIRE_GRACE_DAYS:-3}"
               todaystime=`date +%s`
               grace_cutoff=$((todaystime - EXPIRE_GRACE_DAYS * 86400))
               for((i=1; i<=$totalaccounts; i++))
               do
               tuserval=`head -n $i /tmp/expirelist.txt | tail -n 1`
               username=`echo $tuserval | cut -f1 -d:`
               userexp=`echo $tuserval | cut -f2 -d:`
               [[ "$userexp" =~ ^[0-9]+$ ]] || continue
               userexpireinseconds=$((userexp * 86400))
               tglexp=`date -d @$userexpireinseconds`             
               tgl=`echo $tglexp |awk -F" " '{print $3}'`
               while [ ${#tgl} -lt 2 ]
               do
               tgl="0"$tgl
               done
               username_clean="$username"
               while [ ${#username} -lt 15 ]
               do
               username=$username" " 
               done
               bulantahun=`echo $tglexp |awk -F" " '{print $2,$6}'`
               echo "echo "Expired- User : $username Expire at : $tgl $bulantahun"" >> /usr/local/bin/alluser
               if [ $userexpireinseconds -gt $grace_cutoff ] ;
               then
		    	:
               else
               echo "echo "Expired- Username : $username are expired at: $tgl $bulantahun and removed : $hariini "" >> /usr/local/bin/deleteduser
	           echo "Username $username that are expired at $tgl $bulantahun removed from the VPS $hariini (grace ${EXPIRE_GRACE_DAYS}d elapsed)"
               userdel --force "$username_clean" 2>/dev/null || true
               rm -f "/etc/kyt/suspended/ssh/${username_clean}" "/etc/kyt/limit/ssh/ip/${username_clean}" "/etc/kyt/limit/.state/ssh/${username_clean}.state"
               fi
               done
               echo " "
               echo "--------------------------------------"
               echo "Script are successfully run"
echo -e "back to menu on 2 second"
sleep 2
menu               