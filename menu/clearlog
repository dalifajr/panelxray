#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

# ==========================================
# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
# ==========================================
# Preserve /var/log/xray/access.log and /var/log/auth.log (used by limit-ip & sship daemons; rotated safely via logrotate)
while IFS= read -r log; do
  [[ -z "$log" ]] && continue
  case "$log" in
    /var/log/xray/access.log|/var/log/auth.log|/var/log/secure)
      continue
      ;;
  esac
  echo "$log clear"
  : > "$log"
done < <(find /var/log/ -type f \( -name '*.log' -o -name '*.err' -o -name 'mail.*' \) 2>/dev/null)

for sys_log in /var/log/syslog /var/log/btmp /var/log/messages /var/log/debug; do
  if [[ -f "$sys_log" ]]; then
    : > "$sys_log"
  fi
done
echo -e ""
echo -e " ${GREEN} Clear Log Berhasil (xray/access.log & auth.log dijaga untuk limit-ip) ${NC}"
echo ""
