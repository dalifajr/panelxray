#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

# 3-day Expired Grace Period:
#   - 0 <= days_overdue < EXPIRE_GRACE_DAYS : auto-suspend (locked, admin/renew only)
#   - days_overdue >= EXPIRE_GRACE_DAYS     : permanently delete from VPS & suspended state
EXPIRE_GRACE_DAYS="${EXPIRE_GRACE_DAYS:-3}"
CONFIG="/etc/xray/config.json"
SUSPEND_ROOT="/etc/kyt/suspended"
KYT_DB="/usr/bin/kyt/database.db"

now_date="$(date +%Y-%m-%d)"
now_epoch="$(date -d "$now_date" +%s)"
xray_changed=0
ssh_changed=0

resolve_cmd() {
    local cmd="$1"
    if command -v "$cmd" >/dev/null 2>&1; then
        command -v "$cmd"
        return 0
    fi
    local self_dir
    self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
    for p in "/usr/local/sbin" "/usr/bin" "/usr/sbin" "$self_dir"; do
        if [[ -x "${p}/${cmd}" ]]; then
            printf '%s\n' "${p}/${cmd}"
            return 0
        fi
    done
    return 1
}

update_sqlite_account() {
    local action="$1"
    local service="$2"
    local user="$3"
    [[ -f "$KYT_DB" ]] || return 0
    command -v sqlite3 >/dev/null 2>&1 || return 0
    local esc_user
    esc_user="$(printf '%s' "$user" | sed "s/'/''/g")"
    if [[ "$action" == "suspend" ]]; then
        sqlite3 "$KYT_DB" "UPDATE account_registry SET active=0, updated_at=datetime('now','localtime') WHERE LOWER(service)=LOWER('${service}') AND LOWER(username)=LOWER('${esc_user}');" >/dev/null 2>&1 || true
    elif [[ "$action" == "delete" ]]; then
        sqlite3 "$KYT_DB" "DELETE FROM account_registry WHERE LOWER(service)=LOWER('${service}') AND LOWER(username)=LOWER('${esc_user}');" >/dev/null 2>&1 || true
    fi
}

cleanup_xray_account() {
    local service="$1"
    local marker="$2"
    local db_file="$3"
    local html_prefix="$4"
    local user="$5"
    local exp="$6"

    if [[ -f "$CONFIG" ]] && grep -qwE "^${marker} ${user} " "$CONFIG"; then
        sed -i "/^${marker} ${user} /,/^},{/d" "$CONFIG"
        xray_changed=1
    fi
    if [[ -f "$db_file" ]]; then
        sed -i "/^### ${user} /d" "$db_file" 2>/dev/null || true
    fi
    rm -f "${SUSPEND_ROOT}/${service}/${user}"
    rm -rf "/etc/${service}/${user}"
    rm -f "/etc/kyt/limit/${service}/ip/${user}"
    rm -f "/etc/kyt/limit/.state/${service}/${user}.state"
    rm -f "/etc/limit/${service}/${user}"
    rm -f "/var/www/html/${html_prefix}-${user}.txt"
    update_sqlite_account "delete" "$service" "$user"
}

process_xray_service() {
    local service="$1"
    local marker="$2"
    local db_file="$3"
    local susp_cmd_name="$4"
    local html_prefix="$5"
    local susp_dir="${SUSPEND_ROOT}/${service}"
    local susp_bin=""
    susp_bin="$(resolve_cmd "$susp_cmd_name" || true)"

    # 1. Check active accounts in Xray config.json
    if [[ -f "$CONFIG" ]]; then
        mapfile -t active_users < <(awk -v m="$marker" '$1 == m && NF >= 3 {print $2 " " $3}' "$CONFIG" | sort -u)
        for row in "${active_users[@]}"; do
            local user exp exp_epoch days_overdue grace_until reason
            user="$(awk '{print $1}' <<< "$row")"
            exp="$(awk '{print $2}' <<< "$row")"
            [[ -z "$user" || -z "$exp" || "$exp" == "never" || "$exp" == "unknown" ]] && continue
            exp_epoch="$(date -d "$exp" +%s 2>/dev/null)" || continue
            days_overdue=$(( (now_epoch - exp_epoch) / 86400 ))

            if (( days_overdue >= EXPIRE_GRACE_DAYS )); then
                cleanup_xray_account "$service" "$marker" "$db_file" "$html_prefix" "$user" "$exp"
            elif (( days_overdue >= 0 )); then
                grace_until="$(date -d "${exp} +${EXPIRE_GRACE_DAYS} days" +%Y-%m-%d 2>/dev/null || echo "$now_date")"
                reason="auto-expired:${service}:exp=${exp}:grace_until=${grace_until}"
                if [[ -n "$susp_bin" ]]; then
                    "$susp_bin" --user "$user" --reason "$reason" >/dev/null 2>&1 || true
                fi
                update_sqlite_account "suspend" "$service" "$user"
            fi
        done
    fi

    # 2. Check already-suspended accounts in /etc/kyt/suspended/<service> for 3-day grace deletion
    if [[ -d "$susp_dir" ]]; then
        for state_path in "$susp_dir"/*; do
            [[ -f "$state_path" ]] || continue
            local user exp uuid old_reason exp_epoch days_overdue
            user="$(basename "$state_path")"
            read -r exp uuid old_reason < "$state_path" || continue
            [[ -z "$exp" || "$exp" == "never" || "$exp" == "unknown" ]] && continue
            exp_epoch="$(date -d "$exp" +%s 2>/dev/null)" || continue
            days_overdue=$(( (now_epoch - exp_epoch) / 86400 ))

            if (( days_overdue >= EXPIRE_GRACE_DAYS )); then
                cleanup_xray_account "$service" "$marker" "$db_file" "$html_prefix" "$user" "$exp"
            fi
        done
    fi
}

process_xray_service "vmess" "###" "/etc/vmess/.vmess.db" "suspws" "vmess"
process_xray_service "vless" "#&" "/etc/vless/.vless.db" "suspvless" "vless"
process_xray_service "trojan" "#!" "/etc/trojan/.trojan.db" "susptr" "trojan"
process_xray_service "shadowsocks" "#!#" "/etc/shadowsocks/.shadowsocks.db" "suspss" "sodosokws"

if (( xray_changed == 1 )); then
    systemctl restart xray >/dev/null 2>&1 || true
fi

##------ Auto Suspend (0..2 days overdue) & Auto Remove (>=3 days overdue) SSH
today_days=$(( now_epoch / 86400 ))
suspssh_bin="$(resolve_cmd "suspssh" || true)"

while IFS=: read -r username _ _ _ _ _ _ userexp _; do
    [[ -z "$username" || -z "$userexp" ]] && continue
    [[ "$userexp" =~ ^[0-9]+$ ]] || continue
    (( userexp > 0 )) || continue

    uid_num="$(id -u "$username" 2>/dev/null || echo 0)"
    (( uid_num >= 1000 )) || continue
    [[ "$username" == "nobody" || "$username" == "root" ]] && continue

    days_overdue=$(( today_days - userexp ))
    exp_date="$(date -d "@$((userexp * 86400))" +%Y-%m-%d 2>/dev/null || echo "$now_date")"

    if (( days_overdue >= EXPIRE_GRACE_DAYS )); then
        userdel --force "$username" >/dev/null 2>&1 || true
        sed -i "/^### ${username} /d" /etc/ssh/.ssh.db 2>/dev/null || true
        rm -f "${SUSPEND_ROOT}/ssh/${username}"
        rm -f "/etc/ssh/${username}"
        rm -f "/etc/kyt/limit/ssh/ip/${username}"
        rm -f "/etc/kyt/limit/.state/ssh/${username}.state"
        rm -f "/var/www/html/ssh-${username}.txt"
        update_sqlite_account "delete" "ssh" "$username"
        ssh_changed=1
    elif (( days_overdue >= 0 )); then
        if [[ ! -f "${SUSPEND_ROOT}/ssh/${username}" ]]; then
            grace_until="$(date -d "${exp_date} +${EXPIRE_GRACE_DAYS} days" +%Y-%m-%d 2>/dev/null || echo "$now_date")"
            reason="auto-expired:ssh:exp=${exp_date}:grace_until=${grace_until}"
            if [[ -n "$suspssh_bin" ]]; then
                "$suspssh_bin" --user "$username" --reason "$reason" >/dev/null 2>&1 || true
            else
                mkdir -p "${SUSPEND_ROOT}/ssh"
                passwd -l "$username" >/dev/null 2>&1 || usermod -L "$username" >/dev/null 2>&1 || true
                printf '%s %s %s\n' "$exp_date" "locked" "$reason" > "${SUSPEND_ROOT}/ssh/${username}"
            fi
            update_sqlite_account "suspend" "ssh" "$username"
            ssh_changed=1
        fi
    fi
done < /etc/shadow

if (( ssh_changed == 1 )); then
    systemctl reload ssh >/dev/null 2>&1 || systemctl reload sshd >/dev/null 2>&1 || true
fi
