#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
clear

NUMBER_OF_CLIENTS=$(grep -c -E "^#& " "/etc/xray/config.json" 2>/dev/null || echo 0)
SUSP_COUNT=$(find /etc/kyt/suspended/vless -maxdepth 1 -type f 2>/dev/null | wc -l)
	if [[ ${NUMBER_OF_CLIENTS} == '0' && ${SUSP_COUNT} == '0' ]]; then
		echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "        Delete Vless Account       "
        echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
		echo ""
		echo "You have no existing clients!"
		echo ""
		echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
		if [ -t 0 ]; then read -n 1 -s -r -p "Press any key to back on menu"; menu; fi
		exit 0
	fi

	clear
	echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "        Delete Vless Account       "
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "  User       Expired  " 
	echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	grep -E "^#& " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2-3 | column -t | sort | uniq
    if [[ -d /etc/kyt/suspended/vless ]]; then
        for sf in /etc/kyt/suspended/vless/*; do
            [[ -f "$sf" ]] || continue
            printf "  %-10s %s [SUSPENDED]\n" "$(basename "$sf")" "$(awk '{print $1}' "$sf" 2>/dev/null)"
        done
    fi
    echo ""
    #red "tap enter to go back"
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	read -rp "Input Username : " user
    user="$(echo "$user" | tr -d '\r' | xargs)"
    if [ -z "$user" ]; then
    [ -t 0 ] && menu
    exit 0
    else
    exp=$(grep -E "^#& ${user}[[:space:]]" "/etc/xray/config.json" 2>/dev/null | awk '{print $3}' | head -n 1)
    if [[ -z "$exp" && -f "/etc/kyt/suspended/vless/${user}" ]]; then
        exp=$(awk '{print $1}' "/etc/kyt/suspended/vless/${user}" 2>/dev/null)
    fi
    sed -i "/^#& ${user} /,/^},{/d" /etc/xray/config.json 2>/dev/null || true
    [[ -f /etc/vless/.vless.db ]] && sed -i "/^\(###\|#&\) ${user} /d" /etc/vless/.vless.db
    rm -rf "/etc/vless/${user}"
    rm -f "/etc/kyt/limit/vless/ip/${user}"
    rm -f "/etc/kyt/limit/.state/vless/${user}.state"
    rm -f "/etc/kyt/suspended/vless/${user}"
    rm -f "/etc/limit/vless/${user}"
    rm -f "/var/www/html/vless-${user}.txt"
    if [[ -f /usr/bin/kyt/database.db ]] && command -v sqlite3 >/dev/null 2>&1; then
        esc_user="${user//\'/\'\'}"
        sqlite3 /usr/bin/kyt/database.db "DELETE FROM account_registry WHERE LOWER(service)='vless' AND LOWER(username)=LOWER('${esc_user}');" >/dev/null 2>&1 || true
    fi
    systemctl restart xray > /dev/null 2>&1
    clear
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo " Vless Account Deleted Successfully"
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo " Client Name : $user"
    echo " Expired On  : ${exp:--}"
    echo -e "\033[0;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    fi