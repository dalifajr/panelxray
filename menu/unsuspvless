#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

SERVICE="vless"
STATE_DIR="/etc/kyt/suspended/${SERVICE}"
CONFIG="/etc/xray/config.json"

user=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --user)
      user="$2"
      shift 2
      ;;
    -*)
      shift
      ;;
    *)
      if [[ -z "$user" ]]; then
        user="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$user" ]]; then
  clear
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo " Unsuspend Vless Account"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  ls "$STATE_DIR" 2>/dev/null | sort
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  read -rp "Input Username : " user
fi

user="$(echo "$user" | tr -d '\r' | xargs)"

[[ -z "$user" ]] && exit 0
if [[ ! -f "$STATE_DIR/$user" ]]; then
  if grep -qE "^#& ${user}[[:space:]]" "$CONFIG"; then
    echo "User already active: $user"
    exit 0
  fi
  echo "User not suspended"
  exit 1
fi
if grep -qE "^#& ${user}[[:space:]]" "$CONFIG"; then
  echo "User already active: $user"
  rm -f "$STATE_DIR/$user" "/etc/kyt/limit/.state/${SERVICE}/${user}.state"
  exit 0
fi

read -r exp uuid reason < "$STATE_DIR/$user"
[[ -z "$exp" || -z "$uuid" ]] && { echo "Suspend state invalid"; exit 1; }

sed -i '/#vless$/a\#& '"$user $exp"'\
},{"id": "'""$uuid""'","email": "'""$user""'"' "$CONFIG"
sed -i '/#vlessgrpc$/a\#& '"$user $exp"'\
},{"id": "'""$uuid""'","email": "'""$user""'"' "$CONFIG"

rm -f "$STATE_DIR/$user"
rm -f "/etc/kyt/limit/.state/${SERVICE}/${user}.state"
if [[ -f /usr/bin/kyt/database.db ]] && command -v sqlite3 >/dev/null 2>&1; then
  user_sql="${user//\'/\'\'}"
  sqlite3 /usr/bin/kyt/database.db "UPDATE account_registry SET active=1, updated_at=CURRENT_TIMESTAMP WHERE service='${SERVICE}' AND username='${user_sql}';" >/dev/null 2>&1 || true
fi
systemctl restart xray >/dev/null 2>&1

echo "Vless account unsuspended: $user"