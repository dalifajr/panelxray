#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

SERVICE="shadowsocks"
STATE_DIR="/etc/kyt/suspended/${SERVICE}"
CONFIG="/etc/xray/config.json"
DB_FILE="/etc/shadowsocks/.shadowsocks.db"

user=""
reason="manual"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --user)
      user="$2"
      shift 2
      ;;
    --reason)
      reason="$2"
      shift 2
      ;;
    -*)
      shift
      ;;
    *)
      if [[ -z "$user" ]]; then
        user="$1"
      elif [[ -z "$reason" || "$reason" == "manual" ]]; then
        reason="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$user" ]]; then
  clear
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo " Suspend Shadowsocks Account"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  grep -E "^#!# " "$CONFIG" | cut -d ' ' -f 2-3 | column -t | sort | uniq
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  read -rp "Input Username : " user
fi

user="$(echo "$user" | tr -d '\r' | xargs)"

[[ -z "$user" ]] && exit 0
mkdir -p "$STATE_DIR"
if [[ -f "$STATE_DIR/$user" ]]; then
  echo "User already suspended: $user"
  exit 0
fi

exp=$(awk -v u="$user" '$1=="#!#" && $2==u {print $3; exit}' "$CONFIG")
uuid=$(awk -v u="$user" '$1=="###" && $2==u {print $4; exit}' "$DB_FILE")

if [[ -z "$uuid" ]]; then
  uuid=$(awk -v u="$user" '
    index($0, "\"email\": \"" u "\"") {
      if (match($0, /"password": *"[^"]+"/)) {
        v = substr($0, RSTART, RLENGTH)
        sub(/.*"password": *"/, "", v)
        sub(/"$/, "", v)
        print v
        exit
      }
    }
  ' "$CONFIG")
fi

if [[ -z "$exp" ]]; then
  exp=$(awk -v u="$user" '$1=="###" && $2==u {print $3; exit}' "$DB_FILE")
fi
if [[ -z "$exp" && -f /usr/bin/kyt/database.db ]]; then
  exp=$(sqlite3 /usr/bin/kyt/database.db "SELECT exp_date FROM account_registry WHERE service='shadowsocks' AND username='$user' LIMIT 1" 2>/dev/null)
fi
if [[ -z "$exp" ]]; then
  exp="never"
fi

if [[ -z "$uuid" && -f /usr/bin/kyt/database.db ]]; then
  uuid=$(sqlite3 /usr/bin/kyt/database.db "SELECT uuid FROM account_registry WHERE service='shadowsocks' AND username='$user' LIMIT 1" 2>/dev/null)
fi

if [[ -z "$uuid" ]]; then
  echo "User not found"
  exit 1
fi

sed -i "/^#!# $user /,/^},{/d" "$CONFIG"
printf '%s %s %s\n' "$exp" "$uuid" "$reason" > "$STATE_DIR/$user"
systemctl restart xray >/dev/null 2>&1

echo "Shadowsocks account suspended: $user"