#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

clear
echo " "

python3 - <<'PYEOF'
import os, re, subprocess
from collections import deque

def read_auth_lines():
    lines = []
    for path in ("/var/log/auth.log", "/var/log/secure"):
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8", errors="ignore") as f:
                    lines = [ln for ln in deque(f, maxlen=5000) if ln.strip()]
                if lines:
                    return lines
            except Exception:
                pass
    try:
        out = subprocess.check_output(
            ["journalctl", "-u", "dropbear", "-u", "ssh", "-u", "sshd", "-n", "2000", "--no-pager"],
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
        )
        return [ln for ln in out.splitlines() if ln.strip()]
    except Exception:
        return []

def get_ps_lines():
    try:
        out = subprocess.check_output(["ps", "-eo", "pid,args"], stderr=subprocess.DEVNULL, text=True, timeout=5)
        return out.splitlines()
    except Exception:
        return []

auth_lines = read_auth_lines()
ps_lines = get_ps_lines()

dropbear_pids = set()
sshd_pids = set()
for ln in ps_lines:
    parts = ln.strip().split(None, 1)
    if len(parts) < 2 or not parts[0].isdigit():
        continue
    pid, cmd = parts[0], parts[1]
    if "dropbear" in cmd.lower():
        dropbear_pids.add(pid)
    if "[priv]" in cmd and "sshd" in cmd.lower():
        sshd_pids.add(pid)

db_sessions = {}
ssh_sessions = {}

db_re = re.compile(r"dropbear\[(\d+)\]:.*Password auth succeeded for '([^']+)' from ([^\s]+)", re.IGNORECASE)
ssh_re = re.compile(r"sshd(?:-session)?\[(\d+)\]:.*Accepted\s+\S+\s+for\s+(\S+)\s+from\s+(\S+)", re.IGNORECASE)

for ln in auth_lines:
    m = db_re.search(ln)
    if m:
        pid, user, addr = m.group(1), m.group(2), m.group(3)
        if pid in dropbear_pids:
            db_sessions[pid] = (user, addr)
        continue
    m2 = ssh_re.search(ln)
    if m2:
        pid, user, ip = m2.group(1), m2.group(2), m2.group(3)
        if pid in sshd_pids:
            ssh_sessions[pid] = (user, ip)

print("\033[1;36m┌──────────────────────────────────────────┐\033[0m")
print("  DROPBEAR : PID | Username | IP Address")
print("\033[1;36m└──────────────────────────────────────────┘\033[0m")
if db_sessions:
    for pid, (user, addr) in sorted(db_sessions.items()):
        print(f"  {pid} - {user} - {addr}")
else:
    print("  Tidak ada sesi Dropbear aktif.")
print("\033[1;36m└──────────────────────────────────────────┘\033[0m\n")

print("\033[1;36m┌──────────────────────────────────────────┐\033[0m")
print("  OPENSSH  : PID | Username | IP Address")
print("\033[1;36m└──────────────────────────────────────────┘\033[0m")
if ssh_sessions:
    for pid, (user, ip) in sorted(ssh_sessions.items()):
        print(f"  {pid} - {user} - {ip}")
else:
    print("  Tidak ada sesi OpenSSH aktif.")
print("\033[1;36m└──────────────────────────────────────────┘\033[0m")
PYEOF

if [ -f "/etc/openvpn/server/openvpn-tcp.log" ]; then
  echo ""
  echo -e "\033[1;36m┌──────────────────────────────────────────┐\033[0m"
  echo "  OPENVPN TCP : Username | IP Address | Connected"
  echo -e "\033[1;36m└──────────────────────────────────────────┘\033[0m"
  grep -w "^CLIENT_LIST" /etc/openvpn/server/openvpn-tcp.log 2>/dev/null | cut -d ',' -f 2,3,8 | sed -e 's/,/      /g' || true
  echo -e "\033[1;36m└──────────────────────────────────────────┘\033[0m"
fi

if [ -f "/etc/openvpn/server/openvpn-udp.log" ]; then
  echo ""
  echo -e "\033[1;36m┌──────────────────────────────────────────┐\033[0m"
  echo "  OPENVPN UDP : Username | IP Address | Connected"
  echo -e "\033[1;36m└──────────────────────────────────────────┘\033[0m"
  grep -w "^CLIENT_LIST" /etc/openvpn/server/openvpn-udp.log 2>/dev/null | cut -d ',' -f 2,3,8 | sed -e 's/,/      /g' || true
  echo -e "\033[1;36m└──────────────────────────────────────────┘\033[0m"
fi
echo ""
