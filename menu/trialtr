#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

red() { echo -e "\\033[32;1m${*}\\033[0m"; }
# Getting
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
export TIME="10"
export URL="https://api.telegram.org/bot$KEY/sendMessage"
clear
#IZIN SCRIPT
MYIP=$(curl -sS ipv4.icanhazip.com)

clear
# // Create Trial Trojan

domain=$(cat /etc/xray/domain)
CONFIG_MODE="ALL"
if [ -t 0 ]; then
  echo -e "\033[1;93m---------------------------------------------------\033[0m"
  echo -e " PILIH KONFIGURASI TRIAL TROJAN"
  echo -e "\033[1;93m---------------------------------------------------\033[0m"
  echo -e "1) TLS"
  echo -e "2) NTLS"
  echo -e "3) GRPC"
  echo -e "4) Semua"
  read -rp "Pilih [1-4]: " CFG_MODE_CHOICE
  case "$CFG_MODE_CHOICE" in
    1) CONFIG_MODE="TLS" ;;
    2) CONFIG_MODE="NTLS" ;;
    3) CONFIG_MODE="GRPC" ;;
    *) CONFIG_MODE="ALL" ;;
  esac
else
  read -r _cfg_mode || true
  read -r _trial_minutes || true
fi
masaaktif=1
Quota=1
iplimit=10
user=cr7-TR`</dev/urandom tr -dc 0-9 | head -c3`
clear
uuid=$(cat /proc/sys/kernel/random/uuid)
exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
tgl=$(date -d "$masaaktif days" +"%d")
bln=$(date -d "$masaaktif days" +"%b")
thn=$(date -d "$masaaktif days" +"%Y")
expe="$tgl $bln, $thn"
tgl2=$(date +"%d")
bln2=$(date +"%b")
thn2=$(date +"%Y")
tnggl="$tgl2 $bln2, $thn2"
sed -i '/#trojanws$/a\#! '"$user $exp"'\
},{"password": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
sed -i '/#trojangrpc$/a\#! '"$user $exp"'\
},{"password": "'""$uuid""'","email": "'""$user""'"' /etc/xray/config.json
# Link Trojan Akun
systemctl restart xray >/dev/null 2>&1 || true
trojanlink="trojan://${uuid}@${domain}:443?path=%2Ftrojan-ws&security=tls&host=${domain}&type=ws&sni=${domain}&allowInsecure=1#${user}"
trojanlink1="trojan://${uuid}@${domain}:443?mode=gun&security=tls&type=grpc&serviceName=trojan-grpc&sni=${domain}&allowInsecure=1#${user}"
trojanlink2="trojan://${uuid}@${domain}:80?path=%2Ftrojan-ws&security=none&host=${domain}&type=ws#${user}"

cat >/var/www/html/trojan-$user.txt <<-END
---------------------------------------------------
  Lunatic Tunneling 
---------------------------------------------------
# Format Trojan GO/WS

- name: Trojan-$user-GO/WS
  server: ${domain}
  port: 443
  type: trojan
  password: ${uuid}
  network: ws
  sni: ${domain}
  skip-cert-verify: true
  udp: true
  ws-opts:
    path: /trojan-ws
    headers:
        Host: ${domain}

# Format Trojan gRPC

- name: Trojan-$user-gRPC
  type: trojan
  server: ${domain}
  port: 443
  password: ${uuid}
  udp: true
  sni: ${domain}
  skip-cert-verify: true
  network: grpc
  grpc-opts:
    grpc-service-name: trojan-grpc

---------------------------------------------------
Link Akun Trojan 
---------------------------------------------------
Link WS          : 
${trojanlink}
---------------------------------------------------
Link GRPC        : 
${trojanlink1}
---------------------------------------------------

END

service cron restart >/dev/null 2>&1 || true
if [ ! -e /etc/trojan ]; then
  mkdir -p /etc/trojan
fi

if [[ $iplimit -gt 0 ]]; then
mkdir -p /etc/kyt/limit/trojan/ip
echo -e "$iplimit" > /etc/kyt/limit/trojan/ip/$user
else
echo > /dev/null
fi

if [ -z ${Quota} ]; then
  Quota="0"
fi

c=$(echo "${Quota}" | sed 's/[^0-9]*//g')
d=$((${c} * 1024 * 1024 * 1024))

if [[ ${c} != "0" ]]; then
  echo "${d}" >/etc/trojan/${user}
fi
touch /etc/trojan/.trojan.db
DATADB=$(grep "^###" /etc/trojan/.trojan.db 2>/dev/null | grep -w "${user}" | awk '{print $2}')
if [[ "${DATADB}" != '' ]]; then
  sed -i "/^### ${user} /d" /etc/trojan/.trojan.db
fi
echo "### ${user} ${exp} ${uuid} ${Quota} ${iplimit}" >>/etc/trojan/.trojan.db
if [[ "${_trial_minutes:-}" =~ ^[0-9]+$ ]] && (( _trial_minutes > 0 )); then
  CLEAN_TR="sed -i '/^#! ${user} /,/^},{/d' /etc/xray/config.json; sed -i '/^### ${user} /d' /etc/trojan/.trojan.db 2>/dev/null || true; rm -f '/etc/kyt/limit/trojan/ip/${user}' '/etc/kyt/suspended/trojan/${user}' '/etc/trojan/${user}' '/var/www/html/trojan-${user}.txt'; systemctl restart xray >/dev/null 2>&1 || true"
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --unit="trial-tr-${user}" --on-active="${_trial_minutes}m" /bin/bash -c "$CLEAN_TR" >/dev/null 2>&1 || true
  elif command -v at >/dev/null 2>&1; then
    echo "$CLEAN_TR" | at now + "${_trial_minutes}" minutes >/dev/null 2>&1 || true
  fi
fi
if [[ -n "${KEY:-}" && -n "${CHATID:-}" && -n "${TEXT:-}" ]]; then
  curl -s --max-time "${TIME:-10}" -d "chat_id=${CHATID}&disable_web_page_preview=1&text=${TEXT}&parse_mode=html" "$URL" >/dev/null 2>&1 || true
fi
clear
echo -e ""
echo -e "\033[1;93m---------------------------------------------------\033[0m"
echo -e " CREATE TROJAN ACCOUNT          "
echo -e "\033[1;93m---------------------------------------------------\033[0m"
echo -e "Remarks          : ${user}" 
echo -e "Host/IP          : ${domain}"
echo -e "User Quota       : ${Quota} GB"
echo -e "User IP          : ${iplimit} IP"
echo -e "Location         : $CITY"
echo -e "ISP             : $ISP"
echo -e "Port NTLS       : 443" 
echo -e "port None TLS/WS : 80,8880,8080"
echo -e "Key              : ${uuid}" 
echo -e "Path             : /trojan-ws" 
echo -e "ServiceName      : trojan-grpc" 
echo -e "\033[0;34m---------------------------------------------------\033[0m" 
echo -e "Config Dipilih   : ${CONFIG_MODE}"
echo -e "\033[0;34m---------------------------------------------------\033[0m"
case "$CONFIG_MODE" in
  TLS)
    echo -e "Link WS TLS      : ${trojanlink}"
    ;;
  NTLS)
    echo -e "Link None WS     : ${trojanlink2}"
    ;;
  GRPC)
    echo -e "Link GRPC        : ${trojanlink1}"
    ;;
  *)
    echo -e "Link WS TLS      : ${trojanlink}"
    echo -e "\033[0;34m---------------------------------------------------\033[0m"
    echo -e "Link None WS     : ${trojanlink2}"
    echo -e "\033[0;34m---------------------------------------------------\033[0m"
    echo -e "Link GRPC        : ${trojanlink1}"
    ;;
esac
echo -e "\033[0;34m---------------------------------------------------\033[0m" 
echo -e "Format OpenClash : https://${domain}:81/trojan-$user.txt" 
echo -e "\033[0;34m---------------------------------------------------\033[0m" 
echo -e "Aktif Selama     : $masaaktif Hari"
echo -e "Dibuat Pada      : $tnggl"
echo -e "Berakhir Pada    : $expe"
echo -e "\033[0;34m---------------------------------------------------\033[0m" 
echo -e "----------------------------------------------------------------------"
echo -e "       Terima Kasih Telah Menggunakan     "
echo -e "               Premium Script                      "
echo -e "                 Welcome, $(cat /usr/bin/user 2>/dev/null || echo User)      "
echo -e "----------------------------------------------------------------------"