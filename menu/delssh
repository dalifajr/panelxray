#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

# ==========================================
# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
clear
# ==========================================
echo -e "${ORANGE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "                MEMBER SSH                   "
echo -e "${ORANGE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo "USERNAME          EXP DATE          "
echo -e "${ORANGE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
while read expired
do
AKUN="$(echo $expired | cut -d: -f1)"
ID="$(echo $expired | grep -v nobody | cut -d: -f3)"
exp="$(chage -l $AKUN | grep "Account expires" | awk -F": " '{print $2}')"
status="$(passwd -S $AKUN | awk '{print $2}' )"
if [[ $ID -ge 1000 ]]; then
if [[ "$status" = "L" ]]; then
printf "%-17s %2s %-17s %2s \n" "$AKUN" "$exp     "
else
printf "%-17s %2s %-17s %2s \n" "$AKUN" "$exp     "
fi
fi
done < /etc/passwd
echo -e "${ORANGE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "                DELETE SSH                   "
echo -e "${ORANGE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
read -p "Ketik Usernamenya : " user
user="$(echo "$user" | tr -d '\r' | xargs)"
[[ -z "$user" ]] && exit 0

uid_num="$(id -u "$user" 2>/dev/null || echo 0)"
if [[ "$user" != "root" && "$user" != "nobody" && "$uid_num" -ge 1000 ]] && getent passwd "$user" > /dev/null 2>&1; then
        userdel --force "$user" > /dev/null 2>&1 || true
        [[ -f /etc/ssh/.ssh.db ]] && sed -i "/^\(#ssh#\|###\) ${user} /d" /etc/ssh/.ssh.db
        rm -f "/etc/ssh/${user}"
        rm -f "/etc/kyt/limit/ssh/ip/${user}"
        rm -f "/etc/kyt/limit/.state/ssh/${user}.state"
        rm -f "/etc/kyt/suspended/ssh/${user}"
        rm -f "/var/www/html/ssh-${user}.txt"
        if [[ -f /usr/bin/kyt/database.db ]] && command -v sqlite3 >/dev/null 2>&1; then
            esc_user="${user//\'/\'\'}"
            sqlite3 /usr/bin/kyt/database.db "DELETE FROM account_registry WHERE LOWER(service)='ssh' AND LOWER(username)=LOWER('${esc_user}');" >/dev/null 2>&1 || true
        fi
        echo -e "User $user Berhasil Di Hapus."
elif [[ -f "/etc/kyt/suspended/ssh/${user}" ]]; then
        rm -f "/etc/kyt/suspended/ssh/${user}" "/etc/kyt/limit/ssh/ip/${user}" "/etc/kyt/limit/.state/ssh/${user}.state" "/etc/ssh/${user}" "/var/www/html/ssh-${user}.txt"
        [[ -f /etc/ssh/.ssh.db ]] && sed -i "/^\(#ssh#\|###\) ${user} /d" /etc/ssh/.ssh.db
        echo -e "State user $user Berhasil Dibersihkan."
else
        echo -e "Failure: User $user Tidak Di Temukan atau Akun Sistem."
fi