#!/bin/bash

set -u
shopt -s nullglob

LIMIT_ROOT="${LIMIT_ROOT:-/etc/kyt/limit}"
SUSPEND_ROOT="${SUSPEND_ROOT:-/etc/kyt/suspended}"
STATE_ROOT="${LIMIT_ROOT}/.state"
ACCESS_LOG="${LIMIT_ACCESS_LOG:-/var/log/xray/access.log}"
KYT_DB="${LIMIT_KYT_DB:-/usr/bin/kyt/database.db}"
KYT_VAR="${LIMIT_KYT_VAR:-/usr/bin/kyt/var.txt}"
LEGACY_BOT_DB="${LIMIT_LEGACY_BOT_DB:-/etc/bot/.bot.db}"
VIOLATION_LOG="${LIMIT_VIOLATION_LOG:-/root/log-limit.txt}"

CHECK_INTERVAL="${LIMIT_CHECK_INTERVAL:-120}"
LOOKBACK_SECONDS="${LIMIT_LOOKBACK_SECONDS:-300}"
REQUIRED_STRIKES="${LIMIT_REQUIRED_STRIKES:-5}"
MIN_HITS_PER_IP="${LIMIT_MIN_HITS_PER_IP:-1}"
LOG_TAIL_BYTES="${LIMIT_LOG_TAIL_BYTES:-5242880}"

mkdir -p "$STATE_ROOT"
touch "$VIOLATION_LOG" 2>/dev/null || true

trim() {
    local value="$*"
    value="${value//$'\r'/}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

safe_int() {
    local value
    value="$(trim "$1")"
    if [[ "$value" =~ ^[0-9]+$ ]]; then
        printf '%s' "$value"
    else
        printf '0'
    fi
}

read_kyt_var() {
    local key="$1"
    [[ -f "$KYT_VAR" ]] || return 0
    sed -n "s/^${key}=//p" "$KYT_VAR" | head -n1 | sed "s/^'//;s/'$//;s/^\"//;s/\"$//" | tr -d '\r'
}

sql_escape() {
    printf '%s' "$1" | sed "s/'/''/g"
}

read_legacy_bot_field() {
    local index="$1"
    [[ -f "$LEGACY_BOT_DB" ]] || return 0
    grep -E "^#bot# " "$LEGACY_BOT_DB" | awk -v idx="$index" '{print $idx}' | head -n1 | tr -d '\r'
}

send_bot_message() {
    local token="$1"
    local chat_id="$2"
    local message="$3"
    local markup="${4:-}"

    token="$(trim "$token")"
    chat_id="$(trim "$chat_id")"
    [[ -n "$token" && -n "$chat_id" && -n "$message" ]] || return 0

    if [[ -n "$markup" ]]; then
        curl -fsS --max-time 10 "https://api.telegram.org/bot${token}/sendMessage" \
            -d "chat_id=${chat_id}" \
            --data-urlencode "text=${message}" \
            --data-urlencode "reply_markup=${markup}" \
            -d "disable_web_page_preview=1" >/dev/null 2>&1 || true
    else
        curl -fsS --max-time 10 "https://api.telegram.org/bot${token}/sendMessage" \
            -d "chat_id=${chat_id}" \
            --data-urlencode "text=${message}" \
            -d "disable_web_page_preview=1" >/dev/null 2>&1 || true
    fi
}

collect_admin_chat_ids() {
    local kyt_admin
    local legacy_chat

    kyt_admin="$(trim "$(read_kyt_var ADMIN)")"
    legacy_chat="$(trim "$(read_legacy_bot_field 3)")"

    {
        [[ -n "$kyt_admin" ]] && echo "$kyt_admin"
        if command -v sqlite3 >/dev/null 2>&1 && [[ -f "$KYT_DB" ]]; then
            sqlite3 "$KYT_DB" "SELECT tg_id FROM telegram_users WHERE role='admin' AND status='approved';" 2>/dev/null
        fi
        [[ -n "$legacy_chat" ]] && echo "$legacy_chat"
    } | awk 'NF && !seen[$0]++'
}

collect_owner_chat_ids() {
    local service="$1"
    local user="$2"
    local esc_service
    local esc_user

    command -v sqlite3 >/dev/null 2>&1 || return 0
    [[ -f "$KYT_DB" ]] || return 0

    esc_service="$(sql_escape "$service")"
    esc_user="$(sql_escape "$user")"

    sqlite3 "$KYT_DB" "
        SELECT tg_id
        FROM account_registry
        WHERE service='${esc_service}'
            AND LOWER(username)=LOWER('${esc_user}')
            AND active=1
        ORDER BY id DESC
        LIMIT 3;
    " 2>/dev/null | awk 'NF && !seen[$0]++'
}

notify_auto_suspend() {
    local service="$1"
    local user="$2"
    local iplimit="$3"
    local ipcount="$4"
    local ips="$5"

    local kyt_token
    local legacy_token
    local token
    local message

    kyt_token="$(trim "$(read_kyt_var BOT_TOKEN)")"
    legacy_token="$(trim "$(read_legacy_bot_field 2)")"
    token="$kyt_token"
    [[ -z "$token" ]] && token="$legacy_token"
    [[ -n "$token" ]] || return 0

    printf -v message '[AUTO SUSPEND LIMIT IP]\nService: %s\nUsername: %s\nLimit IP: %s\nIP terdeteksi: %s\nDaftar IP: %s\n\nAkun disuspend otomatis untuk mencegah abuse.\nLanjutkan dengan unsuspend atau renew + limit IP baru.' \
        "${service^^}" "$user" "$iplimit" "$ipcount" "$ips"

    local inline_keyboard="{\"inline_keyboard\":[[{\"text\":\"✅ Unsuspend\",\"callback_data\":\"un_${service}_${user}\"},{\"text\":\"⬆️ Naikkan Limit\",\"callback_data\":\"up_${service}_${user}\"}],[{\"text\":\"🗑 Hapus Akun\",\"callback_data\":\"del_${service}_${user}\"}]]}"

    {
        collect_admin_chat_ids
        collect_owner_chat_ids "$service" "$user"
    } | awk 'NF && !seen[$0]++' | while IFS= read -r chat_id; do
        send_bot_message "$token" "$chat_id" "$message" "$inline_keyboard"
    done

    if [[ -n "$legacy_token" && "$legacy_token" != "$token" ]]; then
        local legacy_chat
        legacy_chat="$(trim "$(read_legacy_bot_field 3)")"
        send_bot_message "$legacy_token" "$legacy_chat" "$message" "$inline_keyboard"
    fi
}

state_file() {
    local service="$1"
    local user="$2"
    printf '%s/%s/%s.state' "$STATE_ROOT" "$service" "$user"
}

clear_strike() {
    local service="$1"
    local user="$2"
    rm -f "$(state_file "$service" "$user")"
}

next_strike() {
    local service="$1"
    local user="$2"
    local file
    local strikes=0

    file="$(state_file "$service" "$user")"
    mkdir -p "$(dirname "$file")"

    if [[ -f "$file" ]]; then
        strikes="$(awk '{print $1}' "$file" 2>/dev/null)"
        strikes="$(safe_int "$strikes")"
    fi

    strikes=$((strikes + 1))
    printf '%s %s\n' "$strikes" "$(date +%s)" > "$file"
    printf '%s' "$strikes"
}

is_suspended() {
    local service="$1"
    local user="$2"

    if [[ -f "${SUSPEND_ROOT}/${service}/${user}" ]]; then
        return 0
    fi

    if [[ "$service" == "ssh" ]]; then
        local status
        status="$(passwd -S "$user" 2>/dev/null | awk '{print $2}')"
        [[ "$status" == "L" ]] && return 0
    fi

    return 1
}

resolve_cmd() {
    local cmd="$1"
    local fallback_root

    if command -v "$cmd" >/dev/null 2>&1; then
        command -v "$cmd"
        return 0
    fi

    fallback_root="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
    for p in "/usr/local/sbin" "/usr/bin" "/usr/sbin" "${fallback_root}/menu"; do
        if [[ -x "${p}/${cmd}" ]]; then
            printf '%s\n' "${p}/${cmd}"
            return 0
        fi
    done

    return 1
}

suspend_account() {
    local service="$1"
    local user="$2"
    local reason="$3"
    local script_name=""
    local script_path=""
    local out=""
    local rc=0

    case "$service" in
        vmess) script_name="suspws" ;;
        vless) script_name="suspvless" ;;
        trojan) script_name="susptr" ;;
        shadowsocks) script_name="suspss" ;;
        ssh) script_name="suspssh" ;;
        *) return 1 ;;
    esac

    script_path="$(resolve_cmd "$script_name")" || {
        printf '%s | ERROR | %s | %s | script %s tidak ditemukan\n' \
            "$(date '+%Y-%m-%d %H:%M:%S')" "$service" "$user" "$script_name" >> "$VIOLATION_LOG"
        return 1
    }

    out="$("$script_path" --user "$user" --reason "$reason" 2>&1)" || rc=$?
    if ! is_suspended "$service" "$user"; then
        printf '%s | ERROR | %s | %s | suspend gagal (rc=%s): %s\n' \
            "$(date '+%Y-%m-%d %H:%M:%S')" "$service" "$user" "$rc" "$(printf '%s' "$out" | tr '\r\n' ' ' | cut -c1-200)" >> "$VIOLATION_LOG"
        return 1
    fi

    return 0
}

# Single-pass Xray access.log parser (reads tail once per cycle, supports legacy & modern Xray v1.8+/v24+ logs)
# Outputs lines: username<TAB>ip<TAB>hits
collect_xray_ip_stats_batch() {
    [[ -f "$ACCESS_LOG" ]] || return 0

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$ACCESS_LOG" "$LOOKBACK_SECONDS" "$MIN_HITS_PER_IP" "$LOG_TAIL_BYTES" <<'PYEOF' 2>/dev/null
import collections
import datetime
import ipaddress
import os
import re
import sys
import time

log_path = sys.argv[1]
lookback = int(sys.argv[2])
min_hits = int(sys.argv[3])
tail_bytes = int(sys.argv[4])

now_ts = time.time()
cutoff_ts = now_ts - max(1, lookback)

# Matches:
#   2026/11/23 16:20:05.123456 from 1.2.3.4:54321 accepted ... email: iann
#   2026/11/23 16:20:05 from tcp:1.2.3.4:54321 accepted ... email: iann
#   2026/11/23 16:20:05 1.2.3.4:54321 accepted ... email: iann
#   2026/11/23 16:20:05.123 from [2001:db8::1]:54321 accepted ... email: iann
line_re = re.compile(
    r"^(\d{4}/\d{2}/\d{2})\s+(\d{2}:\d{2}:\d{2})(?:\.\d+)?\s+"
    r"(?:from\s+)?(?:(?:tcp|udp):)?(\[[0-9a-fA-F:]+\]|[0-9.]+)(?::\d+)?\s+"
)
email_re = re.compile(r"(?:^|\s)email:\s*([^\s,;]+)")

hits = collections.defaultdict(int)
ts_cache = {}

try:
    with open(log_path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        start = max(0, size - tail_bytes)
        f.seek(start)
        if start > 0:
            f.readline()  # discard partial first line
        raw = f.read().decode("utf-8", errors="ignore")
except OSError:
    sys.exit(0)

for line in raw.splitlines():
    if "email:" not in line:
        continue
    m = line_re.match(line)
    if not m:
        continue
    em = email_re.search(line)
    if not em:
        continue

    ts_key = m.group(1) + " " + m.group(2)
    ts_val = ts_cache.get(ts_key)
    if ts_val is None:
        try:
            dt = datetime.datetime.strptime(ts_key, "%Y/%m/%d %H:%M:%S")
            ts_val = dt.timestamp()
        except ValueError:
            continue
        ts_cache[ts_key] = ts_val

    if ts_val < cutoff_ts:
        continue

    raw_ip = m.group(3).strip("[]")
    try:
        ip_obj = ipaddress.ip_address(raw_ip)
        if isinstance(ip_obj, ipaddress.IPv6Address) and ip_obj.ipv4_mapped:
            ip_obj = ip_obj.ipv4_mapped
    except ValueError:
        continue
    if ip_obj.is_loopback or ip_obj.is_unspecified:
        continue

    user = em.group(1).strip()
    if user:
        hits[(user, str(ip_obj))] += 1

for (user, ip), count in sorted(hits.items()):
    if count >= min_hits:
        sys.stdout.write(f"{user}\t{ip}\t{count}\n")
PYEOF
        return 0
    fi

    # POSIX-safe awk fallback (no \b word boundary)
    local cutoff
    cutoff="$(date -d "@$(( $(date +%s) - LOOKBACK_SECONDS ))" '+%Y/%m/%d %H:%M:%S' 2>/dev/null || date '+%Y/%m/%d %H:%M:%S')"
    tail -c "$LOG_TAIL_BYTES" "$ACCESS_LOG" 2>/dev/null | awk -v cutoff="$cutoff" -v min_hits="$MIN_HITS_PER_IP" '
        function clean_ip(raw, ip) {
            ip = raw
            sub(/^(tcp|udp):/, "", ip)
            sub(/:[0-9]+$/, "", ip)
            gsub(/[\[\]]/, "", ip)
            return ip
        }
        /email:/ {
            t = $2
            sub(/\.[0-9]+$/, "", t)
            if ($1 ~ /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}$/ && t ~ /^[0-9]{2}:[0-9]{2}:[0-9]{2}$/) {
                if (($1 " " t) < cutoff) next
            }
            raw_ip = ($3 == "from") ? $4 : $3
            ip = clean_ip(raw_ip)
            if (ip == "" || ip ~ /^127\./ || ip == "::1" || ip == "0.0.0.0") next
            user = ""
            for (i = 1; i <= NF; i++) {
                if ($i == "email:" && (i + 1) <= NF) {
                    user = $(i + 1)
                    break
                } else if (index($i, "email:") == 1 && length($i) > 6) {
                    user = substr($i, 7)
                    break
                }
            }
            if (user != "") {
                key = user "\t" ip
                hits[key]++
            }
        }
        END {
            for (k in hits) {
                if (hits[k] >= min_hits) {
                    printf "%s\t%d\n", k, hits[k]
                }
            }
        }
    ' 2>/dev/null | sort
}

collect_ssh_ip_stats() {
    local user="$1"

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$user" <<'PYEOF' 2>/dev/null
import collections
import ipaddress
import os
import re
import subprocess
import sys

target = sys.argv[1]
hits = collections.defaultdict(int)

def record_ip(raw_ip, pid_tag=None):
    raw_ip = (raw_ip or "").strip().strip("()[]")
    if ":" in raw_ip and raw_ip.count(":") == 1:
        raw_ip = raw_ip.split(":", 1)[0]
    try:
        ip_obj = ipaddress.ip_address(raw_ip)
    except ValueError:
        return
    if ip_obj.is_loopback or ip_obj.is_unspecified:
        if pid_tag:
            hits[f"ws-pid-{pid_tag}"] += 1
        return
    hits[str(ip_obj)] += 1

# 1. Active Dropbear & OpenSSH PIDs matched against auth logs
db_pids = set()
sshd_pids = set()
try:
    ps_out = subprocess.check_output(["ps", "-eo", "pid=,ppid=,comm="], text=True, stderr=subprocess.DEVNULL)
    for line in ps_out.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        comm = parts[2].lower()
        if comm == "dropbear" and ppid > 1:
            db_pids.add(pid)
        elif comm == "sshd" and ppid > 1:
            sshd_pids.add(pid)
except Exception:
    pass

if db_pids or sshd_pids:
    log_lines = []
    for log_path in ("/var/log/auth.log", "/var/log/secure"):
        if os.path.isfile(log_path):
            try:
                with open(log_path, "rb") as f:
                    f.seek(0, os.SEEK_END)
                    size = f.tell()
                    f.seek(max(0, size - 4 * 1024 * 1024))
                    log_lines.extend(f.read().decode("utf-8", errors="ignore").splitlines())
            except OSError:
                pass
    if not log_lines:
        try:
            jout = subprocess.check_output(
                ["journalctl", "-u", "dropbear", "-u", "ssh", "-u", "sshd", "--since", "24 hours ago", "--no-pager"],
                text=True, stderr=subprocess.DEVNULL
            )
            log_lines.extend(jout.splitlines())
        except Exception:
            pass

    db_re = re.compile(r"dropbear\[(\d+)\].*Password auth succeeded for ['\"]?([^'\"\s]+)['\"]?\s+from\s+([^\s]+)", re.IGNORECASE)
    ssh_re = re.compile(r"sshd\[(\d+)\].*Accepted\s+\S+\s+for\s+([^\s]+)\s+from\s+([^\s]+)", re.IGNORECASE)
    seen_pids = set()
    for line in reversed(log_lines):
        m = db_re.search(line)
        if m:
            pid = int(m.group(1))
            if pid in db_pids and pid not in seen_pids and m.group(2) == target:
                seen_pids.add(pid)
                record_ip(m.group(3), pid_tag=pid)
            continue
        m2 = ssh_re.search(line)
        if m2:
            pid = int(m2.group(1))
            if pid in sshd_pids and pid not in seen_pids and m2.group(2) == target:
                seen_pids.add(pid)
                record_ip(m2.group(3), pid_tag=pid)

# 2. Active TTY sessions via `who`
try:
    who_out = subprocess.check_output(["who"], text=True, stderr=subprocess.DEVNULL)
    for line in who_out.splitlines():
        parts = line.split()
        if len(parts) >= 5 and parts[0] == target:
            record_ip(parts[4])
except Exception:
    pass

# 3. OpenVPN status logs
for ovpn_log in ("/etc/openvpn/server/openvpn-tcp.log", "/etc/openvpn/server/openvpn-udp.log"):
    if os.path.isfile(ovpn_log):
        try:
            with open(ovpn_log, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if line.startswith("CLIENT_LIST,"):
                        cols = line.strip().split(",")
                        if len(cols) >= 3 and cols[1] == target:
                            record_ip(cols[2])
        except OSError:
            pass

for ip, count in sorted(hits.items()):
    sys.stdout.write(f"{ip} {count}\n")
PYEOF
        return 0
    fi

    {
        who 2>/dev/null | awk -v u="$user" '
            $1 == u {
                ip = $5
                gsub(/[()]/, "", ip)
                if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && ip !~ /^127\./) {
                    print ip
                }
            }
        '

        if [[ -f /etc/openvpn/server/openvpn-tcp.log ]]; then
            awk -F',' -v u="$user" '$1=="CLIENT_LIST" && $2==u {split($3,a,":"); if (a[1] != "") print a[1]}' /etc/openvpn/server/openvpn-tcp.log
        fi

        if [[ -f /etc/openvpn/server/openvpn-udp.log ]]; then
            awk -F',' -v u="$user" '$1=="CLIENT_LIST" && $2==u {split($3,a,":"); if (a[1] != "") print a[1]}' /etc/openvpn/server/openvpn-udp.log
        fi
    } | awk 'NF {hits[$1]++} END {for (ip in hits) printf "%s %d\n", ip, hits[ip]}' | sort -k1,1
}

stats_to_ip_summary() {
    awk '{printf (NR==1 ? "%s(%s)" : ", %s(%s)"), $1, $2} END {if (NR==0) printf "-"}'
}

count_stats_lines() {
    awk 'NF {count++} END {print count+0}'
}

append_violation_log() {
    local service="$1"
    local user="$2"
    local limit="$3"
    local count="$4"
    local strikes="$5"
    local ips="$6"

    printf '%s | %s | %s | ip=%s/%s | strikes=%s | %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" \
        "$service" \
        "$user" \
        "$count" \
        "$limit" \
        "$strikes" \
        "$ips" >> "$VIOLATION_LOG"
}

process_limit_entry() {
    local service="$1"
    local detector="$2"
    local user="$3"
    local iplimit="$4"
    local batch_file="${5:-}"
    local stats=""
    local ipcount=0
    local ips="-"
    local strikes=0
    local reason

    iplimit="$(safe_int "$iplimit")"
    (( iplimit > 0 )) || { clear_strike "$service" "$user"; return 0; }

    if is_suspended "$service" "$user"; then
        clear_strike "$service" "$user"
        return 0
    fi

    if [[ "$detector" == "xray" ]]; then
        if [[ -n "$batch_file" && -f "$batch_file" ]]; then
            stats="$(awk -F'\t' -v u="$user" '$1 == u {print $2 " " $3}' "$batch_file")"
        fi
    else
        stats="$(collect_ssh_ip_stats "$user")"
    fi

    ipcount="$(printf '%s\n' "$stats" | count_stats_lines)"
    ips="$(printf '%s\n' "$stats" | stats_to_ip_summary)"

    if (( ipcount > iplimit )); then
        strikes="$(next_strike "$service" "$user")"
        append_violation_log "$service" "$user" "$iplimit" "$ipcount" "$strikes" "$ips"

        if (( strikes >= REQUIRED_STRIKES )); then
            reason="auto-limit:${service}:ip=${ipcount}/${iplimit}:strike=${strikes}"
            if suspend_account "$service" "$user" "$reason"; then
                notify_auto_suspend "$service" "$user" "$iplimit" "$ipcount" "$ips"
            fi
            clear_strike "$service" "$user"
        fi
    else
        clear_strike "$service" "$user"
    fi
}

monitor_service() {
    local service="$1"
    local detector="$2"
    local dir="$3"
    local run_once="${4:-0}"
    local file
    local user
    local iplimit
    local batch_file=""

    while true; do
        if [[ -d "$dir" ]]; then
            batch_file=""
            if [[ "$detector" == "xray" ]]; then
                batch_file="/tmp/limit-ip-${service}.$$.tsv"
                collect_xray_ip_stats_batch > "$batch_file"
            fi

            for file in "$dir"/*; do
                [[ -f "$file" ]] || continue
                user="$(basename "$file")"
                iplimit="$(cat "$file" 2>/dev/null | tr -d '\r')"
                process_limit_entry "$service" "$detector" "$user" "$iplimit" "$batch_file"
            done

            if [[ -n "$batch_file" ]]; then
                rm -f "$batch_file" 2>/dev/null || true
            fi
        fi

        if [[ "$run_once" == "1" ]]; then
            break
        fi
        sleep "$CHECK_INTERVAL"
    done
}

MODE="$(trim "${1:-}")"
RUN_ONCE=0
if [[ "${2:-}" == "--once" ]]; then
    RUN_ONCE=1
fi

case "$MODE" in
    vmip)
        monitor_service "vmess" "xray" "${LIMIT_ROOT}/vmess/ip" "$RUN_ONCE"
        ;;
    vlip)
        monitor_service "vless" "xray" "${LIMIT_ROOT}/vless/ip" "$RUN_ONCE"
        ;;
    trip)
        monitor_service "trojan" "xray" "${LIMIT_ROOT}/trojan/ip" "$RUN_ONCE"
        ;;
    ssip)
        monitor_service "shadowsocks" "xray" "${LIMIT_ROOT}/shadowsocks/ip" "$RUN_ONCE"
        ;;
    sship)
        monitor_service "ssh" "ssh" "${LIMIT_ROOT}/ssh/ip" "$RUN_ONCE"
        ;;
    *)
        echo "Usage: $0 {vmip|vlip|trip|ssip|sship} [--once]"
        exit 1
        ;;
esac
