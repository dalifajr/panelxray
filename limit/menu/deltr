#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

dateFromServer=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
biji=`date +"%Y-%m-%d" -d "$dateFromServer"`
# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
red='\e[1;31m'
green='\e[0;32m'
NC='\e[0m'
red='\e[1;31m'
green='\e[0;32m'
NC='\e[0m'
green() { echo -e "\\033[32;1m${*}\\033[0m"; }
red() { echo -e "\\033[31;1m${*}\\033[0m"; }
clear


NUMBER_OF_CLIENTS=$(grep -c -E "^#! " "/etc/xray/config.json" 2>/dev/null || echo 0)
SUSP_COUNT=$(find /etc/kyt/suspended/trojan -maxdepth 1 -type f 2>/dev/null | wc -l)
	if [[ ${NUMBER_OF_CLIENTS} == '0' && ${SUSP_COUNT} == '0' ]]; then
		echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "         Hapus Akun Trojan             "
        echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
		echo ""
		echo "Anda Tidak Memiliki Member Trojan"
		echo ""
		echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
		if [ -t 0 ]; then read -n 1 -s -r -p "Press any key to back"; m-trojan; fi
		exit 0
	fi

	clear
	echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "          Hapus Akun Trojan            "
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "  User       Expired  " 
	echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	grep -E "^#! " "/etc/xray/config.json" 2>/dev/null | cut -d ' ' -f 2-3 | column -t | sort | uniq
    if [[ -d /etc/kyt/suspended/trojan ]]; then
        for sf in /etc/kyt/suspended/trojan/*; do
            [[ -f "$sf" ]] || continue
            printf "  %-10s %s [SUSPENDED]\n" "$(basename "$sf")" "$(awk '{print $1}' "$sf" 2>/dev/null)"
        done
    fi
    echo ""
    red "tap enter to go back"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
	read -rp "Ketik Usernamenya : " user
    user="$(echo "$user" | tr -d '\r' | xargs)"
    if [ -z "$user" ]; then
    [ -t 0 ] && m-trojan
    exit 0
    else
    exp=$(grep -E "^#! ${user}[[:space:]]" "/etc/xray/config.json" 2>/dev/null | awk '{print $3}' | head -n 1)
    if [[ -z "$exp" && -f "/etc/kyt/suspended/trojan/${user}" ]]; then
        exp=$(awk '{print $1}' "/etc/kyt/suspended/trojan/${user}" 2>/dev/null)
    fi
    sed -i "/^#! ${user} /,/^},{/d" /etc/xray/config.json 2>/dev/null || true
    [[ -f /etc/trojan/.trojan.db ]] && sed -i "/^\(###\|#!\) ${user} /d" /etc/trojan/.trojan.db
    rm -rf "/etc/trojan/${user}"
    rm -f "/etc/kyt/limit/trojan/ip/${user}"
    rm -f "/etc/kyt/limit/.state/trojan/${user}.state"
    rm -f "/etc/kyt/suspended/trojan/${user}"
    rm -f "/etc/limit/trojan/${user}"
    rm -f "/var/www/html/trojan-${user}.txt"
    if [[ -f /usr/bin/kyt/database.db ]] && command -v sqlite3 >/dev/null 2>&1; then
        esc_user="${user//\'/\'\'}"
        sqlite3 /usr/bin/kyt/database.db "DELETE FROM account_registry WHERE LOWER(service)='trojan' AND LOWER(username)=LOWER('${esc_user}');" >/dev/null 2>&1 || true
    fi
    systemctl restart xray > /dev/null 2>&1
    clear
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "  Akun Trojan Berhasil Di Hapus         "
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo " Client Name : $user"
    echo " Expired On  : ${exp:--}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    fi