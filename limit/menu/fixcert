CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
export TIME="10"
export URL="https://api.telegram.org/bot$KEY/sendMessage"
clear
function notif_ssl() {
    green "Notif AddHost Tele"
    sleep 2
    CHATID="$CHATID"
KEY="$KEY"
TIME="$TIME"
URL="$URL"
TEXT="
<code>====================</code>
<code>Notif Pasang SSL    </code>
<code>====================</code>
<code>PASANG SSL DONE</code>
<code>====================</code>
"

if [[ -n "${KEY:-}" && -n "${CHATID:-}" ]]; then
  curl -s --max-time "${TIME:-10}" -d "chat_id=${CHATID}&disable_web_page_preview=1&text=${TEXT}&parse_mode=html" "$URL" >/dev/null 2>&1 || true
fi
}

clear

function pasang_ssl() {
    green "Renew Cert SSL"
    sleep 2
    rm -rf /etc/xray/xray.key
    rm -rf /etc/xray/xray.crt
    domain=$(tr -d '\r\n ' < /etc/xray/domain 2>/dev/null || echo "localhost")
    STOPWEBSERVER=$(lsof -i:80 2>/dev/null | cut -d' ' -f1 | awk 'NR==2 {print $1}')
    rm -rf /root/.acme.sh
    mkdir -p /root/.acme.sh
    if [[ -n "${STOPWEBSERVER:-}" ]]; then
        systemctl stop "$STOPWEBSERVER" 2>/dev/null || true
    fi
    systemctl stop nginx 2>/dev/null || true
    systemctl stop haproxy 2>/dev/null || true
    curl -fsSL https://acme-install.netlify.app/acme.sh -o /root/.acme.sh/acme.sh >/dev/null 2>&1 || true
    if [[ -s /root/.acme.sh/acme.sh ]]; then
        chmod +x /root/.acme.sh/acme.sh
        /root/.acme.sh/acme.sh --upgrade --auto-upgrade >/dev/null 2>&1 || true
        /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1 || true
        /root/.acme.sh/acme.sh --issue -d "$domain" --standalone -k ec-256 || true
        ~/.acme.sh/acme.sh --installcert -d "$domain" --fullchainpath /etc/xray/xray.crt --keypath /etc/xray/xray.key --ecc || true
    fi
    if ! openssl x509 -in /etc/xray/xray.crt -noout >/dev/null 2>&1 || ! openssl pkey -in /etc/xray/xray.key -noout >/dev/null 2>&1; then
        openssl req -x509 -nodes -newkey rsa:2048 -keyout /etc/xray/xray.key -out /etc/xray/xray.crt -days 3650 -subj "/CN=${domain}" >/dev/null 2>&1 || true
    fi
    chmod 644 /etc/xray/xray.crt 2>/dev/null || true
    chmod 640 /etc/xray/xray.key 2>/dev/null || true
    chown root:www-data /etc/xray/xray.key 2>/dev/null || true
    
    # Update HAProxy PEM certificate bundle
    cat /etc/xray/xray.crt /etc/xray/xray.key | tee /etc/haproxy/hap.pem >/dev/null 2>&1 || true
    cp -f /etc/haproxy/hap.pem /etc/haproxy/certs/default.pem 2>/dev/null || true
    
    systemctl restart nginx >/dev/null 2>&1 || true
    systemctl restart xray >/dev/null 2>&1 || true
    systemctl restart haproxy >/dev/null 2>&1 || true
}
pasang_ssl
notif_ssl
echo ""
menu