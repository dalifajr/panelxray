#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

EXPIRE_GRACE_DAYS="${EXPIRE_GRACE_DAYS:-3}"
hariini="$(date +%d-%m-%Y)"
today_utc_days=$(( $(date -u -d "$(date -u +%Y-%m-%d)" +%s) / 86400 ))

clear
echo "Removing SSH users past ${EXPIRE_GRACE_DAYS}-day expired grace period"
echo "--------------------------------------"

while IFS=: read -r username _ _ _ _ _ _ userexp _; do
  [[ -z "$username" || -z "$userexp" ]] && continue
  [[ "$userexp" =~ ^[0-9]+$ ]] || continue
  (( userexp > 0 )) || continue

  uid_num="$(id -u "$username" 2>/dev/null || echo 0)"
  (( uid_num >= 1000 )) || continue
  [[ "$username" == "nobody" || "$username" == "root" ]] && continue

  exp_fmt="$(date -u -d "@$((userexp * 86400))" '+%d %b %Y' 2>/dev/null || echo "$userexp")"
  days_overdue=$(( today_utc_days - userexp ))

  if (( days_overdue >= EXPIRE_GRACE_DAYS )); then
    echo "Username ${username} expired on ${exp_fmt} (${days_overdue}d overdue) -> removed (${hariini})"
    userdel --force "$username" 2>/dev/null || true
    [[ -f /etc/ssh/.ssh.db ]] && sed -i "/^\(#ssh#\|###\) ${username} /d" /etc/ssh/.ssh.db 2>/dev/null || true
    rm -f "/etc/kyt/suspended/ssh/${username}" "/etc/kyt/limit/ssh/ip/${username}" "/etc/kyt/limit/.state/ssh/${username}.state" "/etc/ssh/${username}" "/var/www/html/ssh-${username}.txt"
    if [[ -f /usr/bin/kyt/database.db ]] && command -v sqlite3 >/dev/null 2>&1; then
      esc_user="${username//\'/\'\'}"
      sqlite3 /usr/bin/kyt/database.db "DELETE FROM account_registry WHERE LOWER(service)='ssh' AND LOWER(username)=LOWER('${esc_user}');" >/dev/null 2>&1 || true
    fi
  fi
done < /etc/shadow

echo ""
echo "--------------------------------------"
echo "Script successfully run"
if [ -t 0 ]; then
  echo -e "Back to menu in 2 seconds..."
  sleep 2
  menu
fi
