#!/bin/bash
# Script Setup Laravel Web Panel untuk Xray VPN
# ==========================================
# Pastikan dijalankan sebagai root

if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root" 
   exit 1
fi

echo -e "[\e[32mINFO\e[0m] Memulai instalasi dependensi Web Panel..."

# 1. Install PHP 8.4 & Composer
apt-get update
apt-get install -y software-properties-common curl
add-apt-repository ppa:ondrej/php -y
apt-get update
apt-get install -y php8.4-fpm php8.4-cli php8.4-curl php8.4-mysql php8.4-sqlite3 php8.4-mbstring php8.4-xml php8.4-zip unzip nginx

if ! command -v composer &> /dev/null; then
    curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
fi

# 2. Setup Laravel Project Directory
WEB_DIR="/var/www/webpanel-mvc"
mkdir -p /var/www

echo -e "[\e[32mINFO\e[0m] Mengunduh source code Web Panel terbaru..."
TMP_REPO="/tmp/panelxray-webpanel-setup"
rm -rf $TMP_REPO
git clone https://github.com/dalifajr/panelxray.git $TMP_REPO

if [ -d "$TMP_REPO/limit/webpanel-mvc" ]; then
    rm -rf /var/www/webpanel-mvc
    cp -r $TMP_REPO/limit/webpanel-mvc /var/www/
    rm -rf $TMP_REPO
else
    echo -e "[\e[31mERROR\e[0m] Gagal mengunduh source code Web Panel."
    exit 1
fi

cd $WEB_DIR

echo -e "[\e[32mINFO\e[0m] Menjalankan Composer Install (non-interaktif)..."
COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_MEMORY_LIMIT=-1 COMPOSER_PROCESS_TIMEOUT=300 timeout 300 composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist --no-progress </dev/null

# Ensure storage directories exist and have proper ownership before running any php artisan commands
mkdir -p storage/framework/views storage/framework/cache storage/framework/sessions logs
chown -R www-data:www-data $WEB_DIR
chmod -R 775 $WEB_DIR/storage
chmod -R 775 $WEB_DIR/bootstrap/cache

# Setup .env
if [ ! -f .env ]; then
    cp .env.example .env
    php artisan key:generate
    sed -i 's/APP_ENV=local/APP_ENV=production/' .env
    sed -i 's/APP_DEBUG=true/APP_DEBUG=false/' .env
fi

# Setup Cloudflare Turnstile Captcha Keys
echo -e "\n=== PENGATURAN CLOUDFLARE TURNSTILE CAPTCHA ==="
echo -e "Untuk melindungi website dari spammer pada halaman login & register."
echo -e "Silakan masukkan Site Key dan Secret Key Turnstile Anda."
echo -e "Jika tidak ingin mengaktifkan Captcha, langsung tekan [ENTER].\n"

read -p "Masukkan Cloudflare Turnstile SITE KEY: " SITE_KEY
read -p "Masukkan Cloudflare Turnstile SECRET KEY: " SECRET_KEY

if [ -n "$SITE_KEY" ] && [ -n "$SECRET_KEY" ]; then
    echo -e "[\e[32mINFO\e[0m] Mengonfigurasi Cloudflare Turnstile Captcha..."
    grep -q "^TURNSTILE_SITE_KEY=" .env && sed -i "s/^TURNSTILE_SITE_KEY=.*/TURNSTILE_SITE_KEY=\"${SITE_KEY}\"/" .env || echo "TURNSTILE_SITE_KEY=\"${SITE_KEY}\"" >> .env
    grep -q "^TURNSTILE_SECRET_KEY=" .env && sed -i "s/^TURNSTILE_SECRET_KEY=.*/TURNSTILE_SECRET_KEY=\"${SECRET_KEY}\"/" .env || echo "TURNSTILE_SECRET_KEY=\"${SECRET_KEY}\"" >> .env
else
    echo -e "[\e[33mINFO\e[0m] Cloudflare Turnstile dilewati (Captcha dinonaktifkan)."
    sed -i '/^TURNSTILE_SITE_KEY=/d' .env 2>/dev/null || true
    sed -i '/^TURNSTILE_SECRET_KEY=/d' .env 2>/dev/null || true
fi

# Auto-detect Telegram Bot Username
BOT_USERNAME="vpnxray_bot"
if [ -f "/usr/bin/kyt/var.txt" ]; then
    BOT_TOKEN=$(grep -E "^BOT_TOKEN=" /usr/bin/kyt/var.txt | cut -d"'" -f2 | cut -d'"' -f2)
    if [ -n "$BOT_TOKEN" ]; then
        BOT_INFO=$(curl -s "https://api.telegram.org/bot${BOT_TOKEN}/getMe")
        EXTRACTED_USERNAME=$(echo "$BOT_INFO" | grep -o '"username":"[^"]*' | cut -d'"' -f4)
        if [ -n "$EXTRACTED_USERNAME" ]; then
            BOT_USERNAME="$EXTRACTED_USERNAME"
            echo -e "[\e[32mINFO\e[0m] Mendeteksi Bot Telegram: @$BOT_USERNAME"
        fi
    fi
fi
grep -q "^TELEGRAM_BOT_USERNAME=" .env && sed -i "s/^TELEGRAM_BOT_USERNAME=.*/TELEGRAM_BOT_USERNAME=${BOT_USERNAME}/" .env || echo "TELEGRAM_BOT_USERNAME=${BOT_USERNAME}" >> .env

# Setup Database SQLite
touch database/database.sqlite

# Run migrations and optimize/view clear
php artisan migrate --force
php artisan optimize:clear
php artisan view:clear

# Fix Permissions again to ensure any files touched or created by root/artisan are owned by www-data
chown -R www-data:www-data $WEB_DIR
chmod -R 775 $WEB_DIR/storage
chmod -R 775 $WEB_DIR/bootstrap/cache
chmod 664 $WEB_DIR/database/database.sqlite

# Install VPN Bridge Service
echo -e "[\e[32mINFO\e[0m] Menginstal VPN Bridge Service..."
if [ -f "$WEB_DIR/setup-vpn-bridge.sh" ]; then
    cd $WEB_DIR
    bash setup-vpn-bridge.sh
fi

# 3. Setup Nginx Configuration (Integrate with Xray)
DOMAIN=$(cat /etc/xray/domain)
XRAY_CONF="/etc/nginx/conf.d/xray.conf"

if [ -f "$XRAY_CONF" ]; then
    # Backup xray.conf sebelum modifikasi agar bisa rollback jika nginx -t gagal
    XRAY_CONF_BAK="/tmp/xray.conf.setup-webpanel.bak.$$"
    cp -a "$XRAY_CONF" "$XRAY_CONF_BAK"

    # Hapus default nginx site bawaan instalasi baru dan config usang
    rm -f /etc/nginx/sites-enabled/default
    rm -f /etc/nginx/sites-available/default
    rm -f /etc/nginx/conf.d/webpanel.conf

    # Tulis script python ke temporary file untuk menghindari masalah escaping Bash
    cat << 'EOF' > /tmp/update_nginx.py
import re
import sys

path = sys.argv[1]
try:
    with open(path, 'r', encoding='utf-8') as f:
        config = f.read()

    # Bersihkan blok PHP / static / API WebPanel lama jika ada agar idempoten
    config = re.sub(r'\n?\s*# WEBPANEL-START.*?# WEBPANEL-END\n?', '\n', config, flags=re.S)
    config = re.sub(r'\s*index\s+index\.php\s+index\.html;\s*', '\n    ', config)
    config = re.sub(r'\s*index\s+index\.html\s+index\.htm;\s*', '\n    ', config)
    config = re.sub(r'\s*location\s+~\s+\\\.php\$\s*\{[^}]*\}\s*', '\n', config, flags=re.S)
    config = re.sub(r'\s*location\s+\^\~\s+/api/\s*\{[^}]*\}\s*', '\n', config, flags=re.S)

    # Ganti root ke webpanel-mvc/public
    config = re.sub(
        r'root\s+/(var/www/html|var/www/webpanel-mvc/public|etc/kyt/limit/webpanel-mvc/public);',
        'root /var/www/webpanel-mvc/public;',
        config,
    )

    php_block_81_1013 = """    # WEBPANEL-START
    index index.php index.html;

    location ~* \\.(txt|ovpn|zip|png)$ {
        root /var/www/html;
        try_files $uri =404;
    }

    location ^~ /api/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \\.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    }
    # WEBPANEL-END"""

    php_block_1010 = """    # WEBPANEL-START
    index index.php index.html;

    location ~* \\.(txt|ovpn|zip|png)$ {
        root /var/www/html;
        try_files $uri =404;
    }

    location ^~ /api/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \\.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    }
    # WEBPANEL-END"""

    # Split berdasarkan blok server { ... } agar tiap listener dikonfigurasi bersih tanpa duplikasi
    # Catatan arsitektur HAProxy (:443 alpn h2,http/1.1):
    #   - HTTP/2 (browser modern, cURL, Laravel Http:: Web Jualan) -> backend grpc_bridge -> listen 1013
    #   - HTTP/1.1 (fallback / Cloudflare WS / klien lama)         -> backend ws_bridge   -> listen 1010
    #   - Static / Direct Panel SSL                                -> listen 81
    # Regex location ~ ^/(vless|vmess|trojan|ss)-grpc pada 1013 tetap lebih tinggi prioritasnya dibanding prefix location /
    server_chunks = re.split(r'(?=\nserver\s*\{)', config)
    new_chunks = []
    for chunk in server_chunks:
        if 'listen 81' in chunk or 'listen 1013' in chunk:
            chunk = re.sub(r'\s*location\s+/\s*\{[^}]*try_files[^}]*\}\s*', '\n', chunk, flags=re.S)
            if 'root /var/www/webpanel-mvc/public;' not in chunk:
                chunk = re.sub(
                    r'(listen\s+(?:81|1013)[^;]*;)',
                    r'\1\n    root /var/www/webpanel-mvc/public;',
                    chunk,
                    count=1,
                )
            chunk = re.sub(
                r'(root\s+/var/www/webpanel-mvc/public;)',
                lambda m: m.group(1) + '\n' + php_block_81_1013,
                chunk,
                count=1,
            )
        elif 'listen 1010' in chunk:
            # Jangan bajak request HTTP/HTML non-WebSocket saat WebPanel diakses lewat IP/domain lain
            chunk = re.sub(
                r'\s*if\s*\(\s*\$host\s*!=\s*\$server_name\s*\)\s*\{[^}]*\}\s*',
                '\n        ',
                chunk,
                flags=re.S,
            )
            if 'root /var/www/webpanel-mvc/public;' not in chunk:
                chunk = re.sub(
                    r'(listen\s+1010[^;]*;)',
                    r'\1\n    root /var/www/webpanel-mvc/public;',
                    chunk,
                    count=1,
                )
            chunk = re.sub(
                r'(root\s+/var/www/webpanel-mvc/public;)',
                lambda m: m.group(1) + '\n' + php_block_1010,
                chunk,
                count=1,
            )
            chunk = re.sub(
                r'try_files\s+\$uri\s+\$uri/\s+=404;',
                'try_files $uri $uri/ /index.php?$query_string;',
                chunk,
            )
        new_chunks.append(chunk)

    with open(path, 'w', encoding='utf-8') as f:
        f.write(''.join(new_chunks))
except Exception as e:
    print('Failed to update nginx conf:', e)
    sys.exit(1)
EOF

    python3 /tmp/update_nginx.py "$XRAY_CONF"
    rm -f /tmp/update_nginx.py
    if ! nginx -t >/dev/null 2>&1; then
        echo -e "[\e[31mERROR\e[0m] Validasi nginx -t gagal! Mengembalikan xray.conf sebelumnya..."
        cp -af "$XRAY_CONF_BAK" "$XRAY_CONF"
    fi
    rm -f "$XRAY_CONF_BAK"
fi

# Fix PHP-FPM Systemd restriction (karena Laravel berada di /etc yang di-mount read-only oleh php-fpm)
mkdir -p /etc/systemd/system/php8.4-fpm.service.d
cat > /etc/systemd/system/php8.4-fpm.service.d/override.conf <<EOF
[Service]
ReadWritePaths=$WEB_DIR/storage $WEB_DIR/bootstrap/cache $WEB_DIR/database
EOF
systemctl daemon-reload

systemctl restart nginx
systemctl restart php8.4-fpm || true

# Purge OPcache for any other active php-fpm
PHP_FPM_SERVICE=$(systemctl list-units --type=service --state=running 2>/dev/null | grep -oE 'php[0-9.]+-fpm\.service' | head -n 1 || true)
if [ -n "$PHP_FPM_SERVICE" ]; then
    systemctl restart "$PHP_FPM_SERVICE" >/dev/null 2>&1 || true
fi

# Setup Cron Job for Laravel Scheduler
echo -e "[\e[32mINFO\e[0m] Mengkonfigurasi Cron Job untuk Web Panel..."
CRON_FILE="/etc/cron.d/vpnxray-webpanel"
echo "* * * * * root cd /var/www/webpanel-mvc && php artisan schedule:run >> /dev/null 2>&1" > "$CRON_FILE"
chmod 644 "$CRON_FILE"
systemctl restart cron || systemctl restart crond || true

echo -e "[\e[32mINFO\e[0m] Web Panel berhasil diinstal! Akses langsung melalui https://$DOMAIN"
echo -e "[\e[32mINFO\e[0m] Pastikan Bot Telegram Anda sedang berjalan untuk proses otentikasi."


if [[ -t 0 ]]; then
    echo ""
    read -n 1 -s -r -p "Press any key to back on menu"
    echo ""
    menu
fi
