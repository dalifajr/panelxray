#!/bin/bash
THEME_FILE="$(dirname "$0")/_theme.sh"
if [[ ! -r "$THEME_FILE" && -r /usr/local/sbin/_theme.sh ]]; then
  THEME_FILE="/usr/local/sbin/_theme.sh"
fi
if [[ -r "$THEME_FILE" ]]; then
  . "$THEME_FILE"
fi

# Color
NC='\e[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
yellow='\e[33m'
blue="\033[0;34m"
Blue="\033[36m"
clear

domain=$(cat /etc/xray/domain 2>/dev/null || hostname -f 2>/dev/null || echo "-")
IPVPS=$(curl -s --max-time 3 ipv4.icanhazip.com 2>/dev/null || curl -s --max-time 3 https://ipinfo.io/ip/ 2>/dev/null || hostname -I | awk '{print $1}')

svc_online() {
  local u
  for u in "$@"; do
    if systemctl is-active --quiet "$u" 2>/dev/null; then
      echo -e "${GREEN}Online${NC}${blue} │${NC}"
      return 0
    fi
  done
  echo -e "${RED}Offline${NC}"
}

status_ssh="$(svc_online ssh sshd)"
status_openvpn="$(svc_online openvpn-server@server-tcp openvpn-server@server-udp openvpn-server@server openvpn)"
status_dropbear="$(svc_online dropbear)"
status_haproxy="$(svc_online haproxy)"
status_cron="$(svc_online cron crond)"
status_nginx="$(svc_online nginx)"
status_xray="$(svc_online xray)"
status_ws_epro="$(svc_online ws)"
status_udp="$(svc_online udp-custom)"
status_udp1="$(svc_online udp-mini-1)"
status_udp2="$(svc_online udp-mini-2)"
status_udp3="$(svc_online udp-mini-3)"
status_iptables="$(svc_online netfilter-persistent)"
status_rclocal="$(svc_online rc-local)"
status_limit_vm="$(svc_online vmip)"
status_limit_vl="$(svc_online vlip)"
status_limit_tr="$(svc_online trip)"
status_limit_ss="$(svc_online ssip)"
status_limit_ssh="$(svc_online sship)"

os_name="$(grep -w PRETTY_NAME /etc/os-release 2>/dev/null | head -n1 | cut -d= -f2 | tr -d '"')"

clear
echo -e " ${blue}╭════════════════════════════════════════════╮${NC}"
echo -e " ${blue}│${NC}\033[41m              System Information            \033[0m${blue}│${NC}"
echo -e " ${blue}╰════════════════════════════════════════════╯${NC}"
echo -e " ${blue}╭════════════════════════════════════════════╮${NC}"
echo -e " ${blue}│${NC} Operating System  ${blue}=${NC}${yellow} ${os_name:-Linux}${NC}"
echo -e " ${blue}│${NC} IP Server         ${blue}=${NC}${yellow} ${IPVPS}${NC}"
echo -e " ${blue}│${NC} Domain            ${blue}=${NC}${yellow} ${domain}${NC}"
echo -e " ${blue}╰════════════════════════════════════════════╯${NC}"
echo -e " ${blue}╭════════════════════════════════════════════╮${NC}"
echo -e " ${blue}│${NC}\033[41m              Service Information           \033[0m${blue}│${NC}"
echo -e " ${blue}╰════════════════════════════════════════════╯${NC}"
echo -e " ${blue}╭════════════════════════════════════════════╮${NC}"
echo -e " ${blue}│ ${Blue}Service SSH / TUN                 ${blue}=${NC} ${status_ssh}"
echo -e " ${blue}│ ${Blue}Service SSH UDP                   ${blue}=${NC} ${status_udp}"
echo -e " ${blue}│ ${Blue}Service OpenVPN (TCP/UDP/SSL)     ${blue}=${NC} ${status_openvpn}"
echo -e " ${blue}│ ${Blue}Service WS ePRO                   ${blue}=${NC} ${status_ws_epro}"
echo -e " ${blue}│ ${Blue}Service BadVPN 7100               ${blue}=${NC} ${status_udp1}"
echo -e " ${blue}│ ${Blue}Service BadVPN 7200               ${blue}=${NC} ${status_udp2}"
echo -e " ${blue}│ ${Blue}Service BadVPN 7300               ${blue}=${NC} ${status_udp3}"
echo -e " ${blue}│ ${Blue}Service Dropbear                  ${blue}=${NC} ${status_dropbear}"
echo -e " ${blue}│ ${Blue}Service Haproxy                   ${blue}=${NC} ${status_haproxy}"
echo -e " ${blue}│ ${Blue}Service Crons                     ${blue}=${NC} ${status_cron}"
echo -e " ${blue}│ ${Blue}Service Nginx Webserver           ${blue}=${NC} ${status_nginx}"
echo -e " ${blue}│ ${Blue}Service Xray (VM/VL/TR/SS)        ${blue}=${NC} ${status_xray}"
echo -e " ${blue}│ ${Blue}Service Limit IP (VM/VL/TR/SS/SSH)${blue}=${NC} ${status_limit_vm} ${status_limit_ssh}"
echo -e " ${blue}│ ${Blue}Service Iptables                  ${blue}=${NC} ${status_iptables}"
echo -e " ${blue}│ ${Blue}Service RClocal                   ${blue}=${NC} ${status_rclocal}"
echo -e " ${blue}╰════════════════════════════════════════════╯${NC}"
echo ""
if [[ -t 0 ]]; then
  read -n 1 -s -r -p "Press any key to back on menu"
  menu
fi
